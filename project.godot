; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MONSTER REAL ESTATE"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntime="*uid://beywn0yic3a1l"
GameManager="*res://scripts/core/game_manager.gd"
UITheme="*res://scripts/ui/ui_theme.gd"
GameSettings="*res://scripts/core/game_settings.gd"
TaskManager="*res://scripts/core/task_manager.gd"

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/size/window_width_override=1280.0
window/size/window_height_override=720.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[filesystem]

import/blender/enabled=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
